client = genai.Client(api_key=AQ.Ab8RN6IEUjYRk7-brzXFIjVKV3QHb8R5Q8x8kzsVqC3iHfbH9g)

# Vokabeln & Metadaten aus Nextcloud laden
@st.cache_data(ttl=60) # Cache für 1 Minute
def load_data_from_nextcloud():
    try:
        res = requests.get(WEBDAV_URL, auth=(USERNAME, APP_PASSWORD))
        if res.status_code == 200:
            vocab = res.json()
            # Datum aus HTTP-Header 'Last-Modified'
            last_mod = res.headers.get("Last-Modified", "Unbekannt")
            return vocab, last_mod
    except Exception as e:
        st.error(f"Fehler beim Laden aus Nextcloud: {e}")
    return [], "Keine Daten"

vokabeln, last_sync = load_data_from_nextcloud()

# ==========================================
# SIDEBAR & DASHBOARD
# ==========================================
st.sidebar.title("🇹🇷 Türkisch Agent")
st.sidebar.metric(label="Zuletzt synchronisiert", value=last_sync)

with st.sidebar.expander("📊 Vokabel-Dashboard", expanded=False):
    st.write(f"**Anzahl Vokabeln:** {len(vokabeln)}")
    if vokabeln:
